# Copy to .env and fill in. Never commit .env. This file stays on the agent machine.
# Device credentials (SNMP keys) live only here: they are never sent to the backend.
API_URL=https://your-netmap.onrender.com
AGENT_ID=
AGENT_KEY=
# Only for a backend on this same machine (http://127.0.0.1:8000) during development:
ALLOW_INSECURE_LOCAL=false

# Comma-separated CIDRs to ping-sweep (max 1024 addresses each, 4096 in total)
SCAN_RANGES=10.0.10.0/24
# Comma-separated SNMP targets: ip, ip:port or [ipv6]:port. IP addresses only, no host names.
SNMP_TARGETS=10.0.10.1

# SNMPv3 authPriv (SHA + AES) is preferred. v2c sends the community in clear text: lab only.
SNMP_VERSION=v3
SNMP_V3_USER=
SNMP_V3_AUTH_KEY=
SNMP_V3_PRIV_KEY=
SNMP_V3_AUTH_PROTOCOL=SHA
SNMP_V3_PRIV_PROTOCOL=AES
SNMP_V3_CONTEXT=
SNMP_V2C_COMMUNITY=
SNMP_TIMEOUT_SECONDS=2
SNMP_RETRIES=1

PING_TIMEOUT_MS=1000
POLL_INTERVAL_SECONDS=300

# --- Config backups and changes (Phase 6) -------------------------------------------------
# SSH logins are NOT kept here: they live in an encrypted file managed with
#   python -m netmap_agent.credential_store init | add | list | remove | test
# The file's key comes from CREDENTIAL_STORE_KEY (a Fernet key) or, if empty, a key file next
# to it protected with Windows DPAPI (only this Windows user can unlock it).
CREDENTIAL_STORE_PATH=credentials.enc
CREDENTIAL_STORE_KEY=
# Strongly recommended: an OpenSSH known_hosts file. Empty = accept any host key (lab only).
SSH_KNOWN_HOSTS_FILE=
SSH_MAX_PARALLEL=4
CONFIG_BACKUP_INTERVAL_SECONDS=86400
JOB_POLL_INTERVAL_SECONDS=60
# Cisco changes are pushed with "configure terminal revert timer N": if the agent can't confirm
# the device is still reachable within N minutes, the device undoes the change by itself.
CHANGE_REVERT_MINUTES=5
CHANGE_SAVE_CONFIG=true
# Only the simulator shortens a minute; keep 60 for real devices.
CHANGE_REVERT_SECONDS_PER_MINUTE=60

# --- Simulated campus (python -m simulation.run_simulation) --------------------------------
# Replace the matching lines above with these. The keys are public lab values that only work
# against the simulator; never use them on real equipment.
# API_URL=http://127.0.0.1:8000
# ALLOW_INSECURE_LOCAL=true
# SCAN_RANGES=127.0.0.8/29
# SNMP_TARGETS=127.0.0.11:1161,127.0.0.12:1161,127.0.0.13:1161,127.0.0.14:1161,127.0.0.15:1161,127.0.0.16:1161
# SNMP_V3_USER=netmap-sim
# SNMP_V3_AUTH_KEY=sim-auth-key-not-secret
# SNMP_V3_PRIV_KEY=sim-priv-key-not-secret
# SNMP_V3_CONTEXT=netmap-sim
# SSH simulator (python -m simulation.ssh_sim, then python -m simulation.setup_credentials):
# SSH_KNOWN_HOSTS_FILE=simulation/ssh_known_hosts
# CHANGE_REVERT_SECONDS_PER_MINUTE=12
