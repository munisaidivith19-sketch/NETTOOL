# Copy to .env and fill in. Never commit .env.
# development | test | production  (production disables /docs and turns on HSTS)
ENV=development

# Local MongoDB (dev):
MONGODB_URI=mongodb://127.0.0.1:27017
# MongoDB Atlas (prod) - only this line changes:
# MONGODB_URI=mongodb+srv://netmap_app:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=netmap

LOG_LEVEL=INFO

# First admin. Used only when the database has no users at all; the admin must change this
# password at first login. Remove both lines from .env after that first login.
# The password needs 12+ characters and must not be a common password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Encrypts agent API keys stored in MongoDB. REQUIRED: the backend won't start without it.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it means every agent needs a new key. To rotate: put the new key first, a comma, then
# the old key; re-create agent keys; then remove the old key.
AGENT_KEY_ENCRYPTION_KEY=

# Required (Phase 8). A different Fernet key that encrypts users' TOTP (two-step sign-in)
# secrets. Generate it the same way. Rotation works the same way: new key first, a comma, then
# the old one. Losing it means every MFA user must be reset (scripts/reset_mfa.py).
MFA_ENCRYPTION_KEY=

# Behind a reverse proxy only (Phase 9): how many proxies append to X-Forwarded-For. 0 = no
# proxy, use the connecting address (local development). Render: 2 (set in render.yaml).
TRUSTED_PROXY_HOPS=0

# bcrypt cost factor. 12 is the minimum outside tests; higher is slower and stronger.
BCRYPT_ROUNDS=12

# IPAM (optional). An address not seen for IP_STALE_DAYS counts as free again (unless reserved).
IP_STALE_DAYS=30
# Two different MACs for one IP within this many minutes = a duplicate-IP alert.
DUPLICATE_IP_WINDOW_MINUTES=60
# Alert when a subnet's usable addresses are this full (resolves 5 points below).
SUBNET_USAGE_ALERT_PERCENT=80

# Monitoring (optional). New-unknown-MAC alerts start this many hours after the first switch
# MAC table arrives; until then every MAC counts as part of the existing network.
NEW_MAC_LEARNING_HOURS=24

# Notifications (optional). Leave a channel's values empty to switch it off.
# Sent for alerts at or above this severity: info | warning | critical
NOTIFY_MIN_SEVERITY=warning
# Telegram: token from @BotFather, chat id of the group or user that receives alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# E-mail. SMTP_SECURITY is starttls (usually port 587) or ssl (usually 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated recipients
SMTP_TO=

# --- AI (Phase 7) --------------------------------------------------------------------
# Language model for Ask NetMap and explanations: none | gemini | groq | ollama.
# "none" uses NetMap's built-in question parser and template explanations (no key needed).
# gemini: free key from Google AI Studio. groq: free key from console.groq.com.
# ollama: a model on this machine (http://127.0.0.1:11434), no key.
LLM_PROVIDER=none
LLM_API_KEY=
# Empty = the provider's default model / address. A base URL must be https or localhost.
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
# Read-only database user for Ask NetMap queries (Atlas: netmap_ai_ro, role "read" on
# netmap). Empty = the main connection is used and the UI shows a dev-mode warning.
AI_MONGODB_URI=
# Per-user limit on AI requests (protects the free-tier model quota).
AI_CALLS_PER_10_MINUTES=20
