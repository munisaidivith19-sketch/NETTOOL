# Copy to .env and fill in. Never commit .env.
# development | test | production  (production disables /docs and /openapi.json)
ENV=development

# Local MongoDB (dev):
MONGODB_URI=mongodb://127.0.0.1:27017
# MongoDB Atlas (prod) - only this line changes:
# MONGODB_URI=mongodb+srv://netmap_app:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=netmap

LOG_LEVEL=INFO
